/* ==========================================================================
 * Dynamic GTK 3 Theme Template
 * ========================================================================== */

@define-color background {background_color};
@define-color background_alt {background_alt_color};
@define-color foreground {foreground_color};

@define-color black {black_color};
@define-color red {red_color};
@define-color green {green_color};
@define-color yellow {yellow_color};
@define-color blue {blue_color};
@define-color magenta {magenta_color};
@define-color cyan {cyan_color};
@define-color orange {orange_color};
@define-color white {white_color};

/* --------------------------------------------------------------------------
 * Semantic colors
 * -------------------------------------------------------------------------- */

@define-color accent @{primary_color_name};
@define-color accent_hover @{primary_color_name};
@define-color accent_active @{primary_color_name};

@define-color window_bg @background;
@define-color view_bg @background;
@define-color header_bg @background;

@define-color surface @background;
@define-color surface_hover @background_alt;
@define-color surface_active @{primary_color_name};

@define-color text @foreground;
@define-color text_muted @white;
@define-color text_disabled @black;

@define-color destructive @red;
@define-color success @green;
@define-color warning @yellow;

@define-color border @black;
@define-color border_focus @blue;

/* --------------------------------------------------------------------------
 * GTK 3 Engine Standard Variables (Primary driver for GTK 3 apps)
 * -------------------------------------------------------------------------- */

@define-color theme_bg_color @background;
@define-color theme_fg_color @foreground;

@define-color theme_base_color @background;
@define-color theme_text_color @foreground;

@define-color theme_selected_bg_color @{primary_color_name};
@define-color theme_selected_fg_color @background;

@define-color theme_view_hover_bg @background_alt;
@define-color theme_view_active_bg @{primary_color_name};


/* ==========================================================================
 * Global Core Rules
 * ========================================================================== */

* {{
    color: @text;
    background-clip: padding-box;
    border-color: @border;
    background: @background;
}}

window,
.background {{
    background-color: @window_bg;
    color: @text;
}}

/* ==========================================================================
 * Interactive Components (Buttons & Controls)
 * ========================================================================== */

button {{
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
}}

button:hover {{
    background-color: @surface_hover;
    border-color: @accent;
    color: @foreground;
}}

button:active,
button:checked {{
    background-color: @accent;
    color: @background;
    border-color: @accent;
}}

button:disabled {{
    background-color: @background_alt;
    color: @text_disabled;
    border-color: @border;
}}

button.suggested-action {{
    background-color: @accent;
    color: @background;
    border-color: @accent;
}}

button.destructive-action {{
    background-color: @destructive;
    color: @background;
    border-color: @destructive;
}}

entry,
spinbutton,
combobox,
combobox entry {{
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
}}

entry:focus,
spinbutton:focus,
combobox:focus {{
    border-color: @border_focus;
}}

/* ==========================================================================
 * Selections & Hover States (Pavucontrol, TreeViews, Lists & Grids)
 * ========================================================================== */

/* Selection Highlight Across All GTK 3 Apps */
selection,
*:selected,
.selected,
row:selected,
treeview.view:selected,
iconview:selected,
.sidebar:selected,
.sidebar row:selected {{
    background-color: @accent !important;
    color: @background !important;
}}

/* Universal Hovering for GTK 3 Views and Pavucontrol Tabs/Rows */
row:hover,
row.activatable:hover,
treeview.view:hover,
iconview:hover,
.sidebar row:hover {{
    background-color: @surface_hover !important;
    color: @foreground !important;
}}

/* Special Case: Inner Label Fix for Selected Items */
row:selected *,
treeview.view:selected *,
iconview:selected * {{
    color: @background !important;
}}

/* ==========================================================================
 * Menus, Popovers, & Headers
 * ========================================================================== */

headerbar {{
    background-color: @header_bg;
    color: @text;
    border-bottom: 1px solid @border;
    box-shadow: none;
}}

headerbar button {{
    background-color: transparent;
    border-color: transparent;
}}

headerbar button:hover {{
    background-color: @surface_hover;
}}

popover,
menu,
.menu,
.context-menu {{
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
}}

menuitem:hover,
.menuitem:hover {{
    background-color: @accent;
    color: @background;
}}

/* ==========================================================================
 * Notebooks / Tabs (Critical for Pavucontrol)
 * ========================================================================== */

notebook {{
    background-color: @background;
}}

notebook header {{
    background-color: @background_alt;
    border-color: @border;
}}

notebook tab {{
    background-color: transparent;
    color: @text_muted;
    padding: 6px 12px;
}}

notebook tab:hover {{
    color: @text;
    background-color: @surface;
}}

notebook tab:checked,
notebook tab:active {{
    color: @accent;
    background-color: @background;
    border-bottom: 2px solid @accent;
}}

/* ==========================================================================
 * Widgets & Accessories
 * ========================================================================== */

switch {{
    background-color: @background_alt;
    border: 1px solid @border;
    border-radius: 999px;
}}

switch:checked {{
    background-color: @accent;
    border-color: @accent;
}}

switch slider {{
    background-color: @foreground;
    border-radius: 999px;
}}

switch:checked slider {{
    background-color: @background;
}}

scale trough,
progressbar trough {{
    background-color: @background_alt;
}}

scale highlight,
progressbar progress {{
    background-color: @accent;
}}

scale slider {{
    background-color: @foreground;
    border: 1px solid @border;
}}

scrollbar slider {{
    background-color: @background_alt;
    min-width: 8px;
    min-height: 8px;
}}

scrollbar slider:hover {{
    background-color: @accent;
}}

/* ==========================================================================
 * LibreWolf & Firefox Window Frame Fixes
 * ========================================================================== */

/* 1. Main Application & CSD Window Container */
window.background,
window.client-side-decoration,
window.ssd,
window.csd {{
    background-color: @background !important;
    color: @foreground !important;
}}

/* 2. Window Frame Contour / Outer Borders */
window.csd > decoration,
window.ssd > decoration,
decoration {{
    background-color: @background !important;
    border: 1px solid @border;
    box-shadow: none;
}}

/* 3. Headerbar / Titlebar & Tab Bar Region */
headerbar,
.titlebar,
headerbar.tabbar,
.titlebar:not(:active) {{
    background-color: @background !important;
    color: @foreground !important;
    border-bottom: 1px solid @border;
}}

/* 4. Inactive / Unfocused Window States */
window:backdrop,
headerbar:backdrop,
.titlebar:backdrop {{
    background-color: @background !important;
    color: @text_muted !important;
}}
