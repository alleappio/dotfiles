@import "global/theme.rasi"
configuration {
    modes: "drun,run,ssh,window";
    // font: var(font-family-and-size);
    show-icons: true;
    terminal: "kitty";
    matching: "fuzzy";

  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}
