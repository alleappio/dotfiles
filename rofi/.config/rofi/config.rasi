@import "theme.rasi"

configuration {
    modes: "drun,run,ssh,window";
    show-icons: true;
    terminal: "foot";
    matching: "fuzzy";


    display-drun:               "> ";
    display-run:                "Run ";
    display-window:             "Windows ";
    display-ssh:                "SSH ";

}

timeout {
  action: "kb-cancel";
  delay:  0;
}
filebrowser {
  directories-first: true;
  sorting-method:    "name";
}

window {
    width: 500;
}

inputbar {
    children: [ "prompt", "entry" ];
}

listview {
    dynamic: false;
    fixed-height: false;
}
