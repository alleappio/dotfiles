* {
    background:     #181818;
    background-alt: #282828;
    foreground:     #e4e4e4;
    red:            #f43841;
    blue:           #96a6c8;
    green:          #73d936;
    yellow:         #ffdd33;
    orange:         #cc8c3c;
    magenta:        #9e95c7;
    purple:         #9e95c7;
    primary:        var(yellow);
    selected:       var(yellow);
    urgent:         var(red);
    font: "Iosevka Nerd Font 12";
}
